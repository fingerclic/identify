# Fingerclic Identify: isolated development or staging configuration.
# Copy to .env, fill locally, never commit real secret values.
NODE_ENV=development
APP_URL=http://localhost:3000

# MUST point to a database/project owned only by Identify.
# Use separate credentials from the API centrale and My Studio.
IDENTIFY_DATABASE_URL=

# Generate two independent random secrets (>= 32 characters each).
JWT_SECRET=
JWT_REFRESH_SECRET=

# Reference seed requires IDENTIFY_SEED_REFERENCE_DATA=YES at execution time.
IDENTIFY_SEED_REFERENCE_DATA=NO

# OAuth client creation, production account migration, and SMTP are separate steps.
