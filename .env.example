# Fingerclic Identify — local development configuration
# Copy to .env locally; never commit actual values.
NODE_ENV=development
APP_URL=http://localhost:3000

# Generate unique random values securely. Do not reuse across services.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Bootstrap-only values for the JSON development store.
# A production deployment MUST use the real PostgreSQL Prisma client and migrations.
IDENTIFY_BOOTSTRAP_ADMIN_EMAIL=
IDENTIFY_BOOTSTRAP_ADMIN_PASSWORD=
IDENTIFY_NEXUS_CLIENT_SECRET=

# Required for the planned PostgreSQL migration (not used by current JSON shim).
DATABASE_URL=
